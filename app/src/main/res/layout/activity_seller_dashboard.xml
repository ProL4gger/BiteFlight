</LinearLayout>
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR KITCHEN STUDIO" android:textSize="10sp" android:textColor="@color/text_secondary" android:letterSpacing="0.12" android:layout_marginTop="8dp" android:layout_marginBottom="16dp"/>
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your" android:textSize="42sp" android:textColor="@color/text_primary" android:textStyle="bold"/>
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="kitchen." android:textSize="42sp" android:textColor="@color/accent_mid" android:textStyle="bold" android:paddingStart="20dp"/>
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your rules." android:textSize="36sp" android:textColor="@color/primary" android:textStyle="bold"/>
