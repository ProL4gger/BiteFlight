<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- PERSISTENT TOP BAR -->
    <LinearLayout
        android:id="@+id/topBarHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">
        <TextView android:id="@+id/tvAppName" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="BiteFlight." android:textSize="26sp" android:textStyle="bold" android:textColor="@color/primary"/>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnSettings" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Settings" app:srcCompat="@drawable/ic_settings" app:tint="@color/primary"/>
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
