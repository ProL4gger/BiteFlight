<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/studio_panel"
    android:elevation="0dp">

    <ImageView
        android:id="@+id/ivMealPhoto"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/restaurant_photo_background"
        android:clipToOutline="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_logo"
        android:contentDescription="Item photo" />
    <TextView
        android:id="@+id/tvMealName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meal Name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvMealPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="EGP 120"
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tvMealTags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Pizza, Chicken"
        android:textSize="14sp"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="14dp">

        <ImageButton
            android:id="@+id/btnEditMeal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/text_primary"
            android:contentDescription="Edit Item"
            android:padding="10dp" />

        <ImageButton
            android:id="@+id/btnDeleteMeal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/text_primary"
            android:contentDescription="Delete Item"
            android:padding="10dp" />

    </LinearLayout>

</LinearLayout>
