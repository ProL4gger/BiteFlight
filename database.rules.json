{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists() && ((!data.exists() && (newData.child('role').val() === 'BUYER' || newData.child('role').val() === 'SELLER')) || (data.exists() && newData.child('role').val() === data.child('role').val()))",
        ".validate": "newData.hasChildren(['uid', 'role', 'name', 'email'])",
        "uid": { ".validate": "newData.val() === $uid" },
        "role": { ".validate": "newData.val() === 'BUYER' || newData.val() === 'SELLER'" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 320" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "address": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "imageUrl": { ".validate": "newData.isString() && newData.val().length <= 4096" },
        "busy": { ".validate": "newData.isBoolean()" },
        "openingTime": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/))" },
        "closingTime": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/))" },
        "restaurantTimeZone": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "deliveryAddressDetails": {
          ".validate": "newData.hasChildren(['city', 'area', 'street', 'building'])",
          "$field": { ".validate": "($field === 'city' || $field === 'area' || $field === 'street' || $field === 'building' || $field === 'floor' || $field === 'apartment' || $field === 'landmark' || $field === 'instructions') && newData.isString() && newData.val().length <= 1000" }
        },
        "$other": { ".validate": false }
      }
    },
    "restaurants": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.parent().parent().child('users').child($uid).child('role').val() === 'SELLER'",
        ".validate": "newData.hasChildren(['uid', 'role', 'name', 'address', 'imageUrl', 'busy', 'openingTime', 'closingTime', 'restaurantTimeZone'])",
        "uid": { ".validate": "newData.val() === $uid" },
        "role": { ".validate": "newData.val() === 'SELLER'" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "address": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "imageUrl": { ".validate": "newData.isString() && newData.val().length <= 4096" },
        "busy": { ".validate": "newData.isBoolean()" },
        "openingTime": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/))" },
        "closingTime": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/))" },
        "restaurantTimeZone": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "menuItems": {
      ".read": "auth != null",
      ".indexOn": ["sellerId"],
      "$itemId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'SELLER' && ((!data.exists() && newData.exists() && newData.child('sellerId').val() === auth.uid) || (data.exists() && data.child('sellerId').val() === auth.uid && (!newData.exists() || newData.child('sellerId').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['id', 'sellerId', 'name', 'price'])",
        "id": { ".validate": "newData.val() === $itemId" },
        "sellerId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "price": { ".validate": "newData.isNumber() && newData.val() >= 0.01 && newData.val() <= 1000000" },
        "imageUrl": { ".validate": "newData.isString() && newData.val().length <= 4096" },
        "tags": {
          "$index": { ".validate": "newData.isString() && newData.val().length <= 100" }
        },
        "$other": { ".validate": false }
      }
    },
    "orders": {
      ".read": "auth != null && ((query.orderByChild === 'buyerId' && query.equalTo === auth.uid) || (query.orderByChild === 'sellerId' && query.equalTo === auth.uid))",
      ".indexOn": ["buyerId", "sellerId", "createdAt"],
      "$orderId": {
        ".read": "auth != null && (data.child('buyerId').val() === auth.uid || data.child('sellerId').val() === auth.uid || (!data.exists() && $orderId.beginsWith(auth.uid + '_')))",
        ".write": "auth != null && !data.exists() && newData.exists() && $orderId.beginsWith(auth.uid + '_') && root.child('users').child(auth.uid).child('role').val() === 'BUYER' && newData.child('buyerId').val() === auth.uid && root.child('users').child(newData.child('sellerId').val()).child('role').val() === 'SELLER' && root.child('restaurants').child(newData.child('sellerId').val()).child('busy').val() === false && newData.child('status').val() === 'PLACED'",
        ".validate": "data.exists() || newData.hasChildren(['id', 'buyerId', 'sellerId', 'restaurantName', 'deliveryAddress', 'items', 'status', 'createdAt', 'schemaVersion'])",
        "id": { ".validate": "newData.val() === $orderId" },
        "buyerId": { ".validate": "data.exists() || newData.val() === auth.uid" },
        "sellerId": { ".validate": "newData.isString()" },
        "restaurantName": { ".validate": "data.exists() || (newData.isString() && newData.val() === root.child('restaurants').child(newData.parent().child('sellerId').val()).child('name').val())" },
        "deliveryAddress": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000" },
        "createdAt": { ".validate": "data.exists() || (newData.isNumber() && newData.val() === now)" },
        "schemaVersion": { ".validate": "newData.val() === 2" },
        "total": { ".validate": "data.exists() && newData.val() === data.val()" },
        "items": {
          ".validate": "data.exists() || newData.hasChild('0')",
          "$index": {
            ".validate": "data.exists() || ($index.matches(/^(0|[1-9][0-9]?)$/) && newData.hasChildren(['mealId', 'name', 'price', 'quantity']) && root.child('menuItems').child(newData.child('mealId').val()).child('sellerId').val() === newData.parent().parent().child('sellerId').val())",
            "mealId": { ".validate": "data.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 128)" },
            "name": { ".validate": "data.exists() || (newData.isString() && newData.val() === root.child('menuItems').child(newData.parent().child('mealId').val()).child('name').val())" },
            "price": { ".validate": "data.exists() || (newData.isNumber() && newData.val() >= 0.01 && newData.val() <= 1000000 && newData.val() === root.child('menuItems').child(newData.parent().child('mealId').val()).child('price').val())" },
            "quantity": { ".validate": "data.exists() || (newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 99)" },
            "$other": { ".validate": false }
          }
        },
        "status": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'SELLER' && data.parent().child('sellerId').val() === auth.uid && newData.isString() && ((data.val() === 'PLACED' && (newData.val() === 'ACCEPTED' || newData.val() === 'CANCELLED')) || (data.val() === 'ACCEPTED' && (newData.val() === 'PREPARING' || newData.val() === 'CANCELLED')) || (data.val() === 'PREPARING' && newData.val() === 'READY') || (data.val() === 'READY' && newData.val() === 'DELIVERED'))"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
