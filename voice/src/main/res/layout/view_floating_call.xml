<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingVertical="8dp"
    android:background="@drawable/bg_floating_island"
    android:foreground="?attr/selectableItemBackground"
    android:elevation="8dp"
    android:clickable="true"
    android:focusable="true">

    <ImageButton
        android:id="@+id/btnIslandCall"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_floating_call_icon"
        android:contentDescription="@string/voice_floating_open"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_voice_call" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvIslandStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_title"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/tvIslandTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_light"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnIslandEnd"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_end_call"
        android:contentDescription="@string/voice_end" />
</LinearLayout>
