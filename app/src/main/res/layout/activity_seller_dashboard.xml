<TextView android:id="@+id/btnAddItem" android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/studio_circle" android:gravity="center" android:text="+\nAdd a meal" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/white" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"/>
</LinearLayout>
<TextView android:id="@+id/btnMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Made by you.\n\nExplore your menu ↗" android:textSize="23sp" android:textColor="@color/white" android:background="@drawable/studio_deep" android:padding="24dp" android:minHeight="120dp" android:gravity="center_vertical" android:textStyle="bold" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_marginTop="24dp" android:layout_marginEnd="12dp"/>
<TextView android:id="@+id/btnOrders" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Order book.\n\nView orders →" android:textSize="23sp" android:textColor="@color/primary" android:background="@drawable/studio_soft" android:padding="24dp" android:minHeight="120dp" android:gravity="center_vertical" android:textStyle="bold" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_marginTop="18dp" android:layout_marginStart="18dp"/>

