<resources>

    <style name="Base.Theme.BiteFlight"
        parent="Theme.Material3.Light.NoActionBar">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="fontFamily">@font/inter</item><item name="android:fontFamily">@font/inter</item><item name="android:windowLightStatusBar">true</item><item name="android:windowLightNavigationBar">true</item><item name="android:statusBarColor">@color/primary_light</item><item name="android:navigationBarColor">@color/background</item><item name="materialButtonStyle">@style/Widget.BiteFlight.Button</item>
        <item name="homeAsUpIndicator">@drawable/ic_back</item>
    </style>

    <style name="Theme.BiteFlight" parent="Base.Theme.BiteFlight" />

    <style name="Widget.BiteFlight.TextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="passwordToggleTint">@color/text_secondary</item>
    </style>

    <style name="Widget.BiteFlight.Button"
        parent="Widget.Material3.Button">

        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

</resources>
